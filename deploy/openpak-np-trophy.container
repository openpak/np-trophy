# Sample only. Copy to ~/.config/containers/systemd/openpak-np-trophy.container.
# Use a separate env file per service; do not share NP_HTTP_ADDR or OAuth secrets.
[Unit]
Description=OpenPak np-trophy

[Container]
ContainerName=openpak-np-trophy
Image=ghcr.io/openpak/np-trophy:latest
Network=openpak
EnvironmentFile=%h/openpak/deploy/np-trophy.env
Environment=NP_HTTP_ADDR=:8531
Volume=%h/openpak/deploy/ps3-keys:/run/ps3:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
